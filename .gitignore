# Godot 4+ specific ignores
.godot/
/android/
/.import/

# .NET / C# (Mono build)
.mono/
/bin/
/obj/
*.user
mono_crash.*.json

# Exported builds
/build/
*.exe
*.pck
*.zip

# OS / editor cruft
.DS_Store
Thumbs.db

# Local backups of project files (e.g. "RA Engine.csproj.old")
*.old

# godot-ai MCP editor plugin (a dev tool, lives at C:\repos\external\godot-ai) — local-only, not published
/addons/godot_ai/

# Session scratch (debug runs, screenshots, headless test result dumps)
run_*.log
_startup_*.txt
_*.txt
_*.png
_*.png.import
/shots/
.lastpid

# Dev artifact: audio is synthesized at runtime (--gen-audio dumps these for inspection)
assets/audio/
